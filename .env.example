# The same Supabase project as the phone app. An account made in either
# signs into both. The anon key is public by design; row-level security
# protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The AI server (the phone app's EXPO_PUBLIC_API_URL). Needed for the live
# conversation (v1.5) and "help me write"; the app works without it.
VITE_API_URL=

# Where this build is served from, for the links it writes for other people
# (the join link and QR on Family, the invite message, the archive link in
# the book). Leave it EMPTY until app.astoryapp.com is live: the app then
# uses the address the page is served from, which is right on localhost and
# on a preview host. A dev server always uses its own address. Set it only
# for the production build, once that domain answers.
VITE_SITE_URL=
